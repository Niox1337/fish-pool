FISH_NODE_ID=node-1
FISH_NODE_SECRET=
FISH_CONSOLE_URL=https://fish.niox.lol
CLOUDFLARE_TUNNEL_TOKEN=
RUST_LOG=info
# Seconds without messages before idle plugins sleep. 0 disables sleeping.
# FISH_PLUGIN_IDLE_SECS=1800
# 0 loads every plugin process on its own instead of forking it from a shared import.
# FISH_SIDECAR_TEMPLATES=1
# Memory limit of the node container. Leave about 900 MB of a 4 GB host for the system and cloudflared.
# NODE_MEM_LIMIT=2700m
# build compiles node/ while building the image. prebuilt copies deploy/dist/fish-node from scripts/deploy-node.sh.
# NODE_BIN=build

# Mirrors for hosts in mainland China. Leave empty elsewhere.
# UV_IMAGE=astral/uv:0.8.0
# CARGO_REGISTRY=sparse+https://rsproxy.cn/index/
# APT_MIRROR=http://mirrors.tencent.com
# PIP_INDEX=https://mirrors.cloud.tencent.com/pypi/simple
